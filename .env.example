# ---------------------------------------------------------------------------
# Destiny Palm AI - example environment file
# Copy this file to `.env` and edit the values. Never commit your real `.env`.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=8787
NODE_ENV=development

# Comma separated list of origins allowed to call the API.
# Leave empty in development to allow the local Vite dev server.
CORS_ORIGINS=http://localhost:5173

# --- Image analysis -------------------------------------------------------
# Which analysis provider to use:
#   heuristic-cv  -> real, on-server computer vision (default, no API key needed)
#   mock          -> clearly labelled demo data, no real detection at all
#   remote        -> forward the image to your own CV model (see REMOTE_* below)
PALM_ANALYSIS_PROVIDER=heuristic-cv

# Only used when PALM_ANALYSIS_PROVIDER=remote
REMOTE_ANALYSIS_URL=
REMOTE_ANALYSIS_API_KEY=
REMOTE_ANALYSIS_TIMEOUT_MS=15000

# --- Reading text generation ----------------------------------------------
# template  -> deterministic, offline sentence engine (default, no key needed)
# anthropic -> rewrite the same interpretation with the Claude API
READING_TEXT_PROVIDER=template

# Server-side only. This key is NEVER sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=20000

# --- Uploads / limits -----------------------------------------------------
MAX_UPLOAD_BYTES=8000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# How long an uploaded palm image may stay in the server's memory (ms).
# Images are never written to disk and are dropped automatically after this.
IMAGE_RETENTION_MS=900000

# --- Admin dashboard (optional) -------------------------------------------
# Leave empty to keep the admin metrics endpoint disabled.
ADMIN_API_TOKEN=

# --- Frontend (Vite) ------------------------------------------------------
# Only variables prefixed with VITE_ reach the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8787
